+        if (SDK_DIR == null) {
+            SDK_DIR = new File(new File(ApplicationLoader.getFilesDirFixed(), "chaquopy"), "plugins-sdk");
+            if (!SDK_DIR.exists() && !SDK_DIR.mkdirs()) {
