+
+    public MenuContextBuilder withUser(TLRPC.User user) {
+        if (user != null) {
+            contextData.put("user", user);
+            contextData.put("userId", user.id);
+        }
+        return this;
+    }
+
+    public MenuContextBuilder withUserFull(TLRPC.UserFull userFull) {
