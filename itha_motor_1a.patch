+    private static String leadingDigits(String part) {
+        StringBuilder digits = new StringBuilder();
+        for (int i = 0; i < part.length(); i++) {
+            char ch = part.charAt(i);
+            if (Character.isDigit(ch)) {
+                digits.append(ch);
