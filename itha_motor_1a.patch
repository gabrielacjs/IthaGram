+    public String addMenuItem(String pluginId, PyObject object) {
+        if (!isPluginEngineAvailable() || object == null) {
+            return null;
+        }
+        try {
+            MenuItemRecord record = new MenuItemRecord(pluginId, object);
+            if (record.menuType == null) {
