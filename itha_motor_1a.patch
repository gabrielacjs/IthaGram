+    public String fetchParameterValue(String filePath, String key) {
+        if (filePath == null) {
+            return null;
+        }
+        try {
+            File file = new File(filePath);
+            if (file.exists() && file.isFile()) {
+                return parsePluginMetadata(filePath).get(key);
