+def process_updates(account, updates):
+    """Llamado desde MessagesController.processUpdates. False = descartar todo el paquete."""
+    res = execute_updates(account, updates.getClass().getSimpleName(), updates)
+    if res is None:
+        return False
+    try:
+        lst = updates.updates
