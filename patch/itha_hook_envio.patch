+    }
+
+    /** Aviso simple (antes de ejecutar el metodo): lo llama Telegram en el sitio enganchado. */
+    public static void call(Object thiz, String method) {
+        if (entries.isEmpty() || thiz == null) {
+            return;
+        }
+        Param p = new Param();
+        p.thisObject = thiz;
+        p.args = new Object[0];
+        runBefore(thiz, method, p);
     }
 
