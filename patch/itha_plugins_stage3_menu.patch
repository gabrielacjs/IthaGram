 def remove_plugin(pid):
@@ -252,3 +256,86 @@ try:
     IthaHooks.bus = _bus
 except Exception as e:
     log("no se pudo instalar el bus: %s" % e)
+
+
+# ---- menus ----
+_MENU_BASE = 100000
+_menu_actions = {}
+
+
+def _icon_id(name):
+    R = jclass("org.telegram.messenger.R$drawable")
+    for n in (name, "msg_info", "msg_settings"):
+        if not n:
+            continue
+        try:
+            return int(getattr(R, str(n)))
+        except Exception:
+            continue
+    return 0
+
+
+def _context(fragment, message):
+    ctx = {"fragment": fragment, "message": message, "messageObject": message}
+    try:
+        ctx["account"] = int(fragment.getCurrentAccount())
+    except Exception:
+        ctx["account"] = jclass("org.telegram.messenger.UserConfig").selectedAccount
+    try:
+        ctx["context"] = fragment.getParentActivity()
+    except Exception:
+        pass
+    try:
+        ctx["dialog_id"] = fragment.getDialogId()
+        ctx["dialogId"] = ctx["dialog_id"]
+    except Exception:
+        pass
+    return ctx
+
+
+def fill_menu(menu_type, fragment, message, icons, items, options):
+    _menu_actions.clear()
+    Integer = jclass("java.lang.Integer")
+    n = 0
+    for data in menu_items_for(menu_type):
+        opt = _MENU_BASE + n
+        n += 1
+        _menu_actions[opt] = data
+        items.add(str(data.get("text") or ""))
+        options.add(Integer.valueOf(jint(opt)))
+        icons.add(Integer.valueOf(jint(_icon_id(data.get("icon")))))
+
+
+def click_menu(menu_type, fragment, option, message):
+    data = _menu_actions.get(int(option))
+    if data is None:
+        return False
+    try:
+        cb = data.get("on_click")
+        if cb is not None:
+            cb(_context(fragment, message))
+    except Exception:
+        log("menu on_click error: %s" % traceback.format_exc())
+    return True
+
+
+class _MenuBus(dynamic_proxy(jclass("org.telegram.messenger.IthaHooks$MenuBus"))):
+    def fill(self, menu_type, fragment, message, icons, items, options):
+        try:
+            fill_menu(str(menu_type), fragment, message, icons, items, options)
+        except Exception:
+            log("menubus.fill error: %s" % traceback.format_exc())
+
+    def click(self, menu_type, fragment, option, message):
+        try:
+            return bool(click_menu(str(menu_type), fragment, option, message))
+        except Exception:
+            log("menubus.click error: %s" % traceback.format_exc())
+            return False
+
+
+_menu_bus = _MenuBus()
+try:
+    IthaHooks.menuBus = _menu_bus
+except Exception as e:
+    log("no se pudo instalar menuBus: %s" % e)
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/IthaHooks.java b/TMessagesProj/src/main/java/org/telegram/messenger/IthaHooks.java
--- a/TMessagesProj/src/main/java/org/telegram/messenger/IthaHooks.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/IthaHooks.java
@@ -70,1 +70,36 @@
     public static volatile boolean updatesActive;
+    /** Puente para menus de plugins (lo instala ithabus.py). */
+    public interface MenuBus {
+        void fill(String menuType, Object fragment, Object message, java.util.ArrayList<Integer> icons, java.util.ArrayList<CharSequence> items, java.util.ArrayList<Integer> options);
+
+        boolean click(String menuType, Object fragment, int option, Object message);
+    }
+
+    public static volatile MenuBus menuBus;
+    public static volatile boolean menuActive;
+
+    public static void addMessageMenu(Object fragment, MessageObject message, java.util.ArrayList<Integer> icons, java.util.ArrayList<CharSequence> items, java.util.ArrayList<Integer> options) {
+        MenuBus b = menuBus;
+        if (b == null || !menuActive) {
+            return;
+        }
+        try {
+            b.fill("message_context_menu", fragment, message, icons, items, options);
+        } catch (Throwable t) {
+            FileLog.e(t);
+        }
+    }
+
+    /** true = el item era de un plugin y ya se ejecuto. */
+    public static boolean menuClick(Object fragment, int option, MessageObject message) {
+        MenuBus b = menuBus;
+        if (b == null || option < 100000) {
+            return false;
+        }
+        try {
+            return b.click("message_context_menu", fragment, option, message);
+        } catch (Throwable t) {
+            FileLog.e(t);
+            return false;
+        }
+    }
